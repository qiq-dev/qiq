int[] numbers = [10, 20, 30];
foreach (numbers as index => value) {
    print(index);
    print(value);
}

int[] zeroes = new int[2];
zeroes[1] = 7;
foreach (zeroes as value) {
    print(value);
}

string text = "aé界";
foreach (text as position => character) {
    print(position);
    print(character);
}

 map[string, int] scores = {"Ada" => 10};
foreach (scores as name => score) {
    print(name);
    print(score);
}
foreach (scores as score) {
    print(score);
}

function show(int[] values): void {
    foreach (values as value) {
        print(value);
    }
}
show(numbers);

int[] control = [1, 2, 3, 4];
foreach (control as outer) {
    foreach (control as inner) {
        if (inner == 2) {
            continue;
        }
        if (inner == 3) {
            break;
        }
        print(outer);
        print(inner);
    }
    if (outer == 2) {
        break;
    }
}

// range(count): 0 up to count - 1, and nothing when count is 0 or less,
// as for (i = 0; i < count; i++) would.
string[] queue = ["build", "test"];
foreach (range(len(queue)) as i) {
    print(i, queue[i]);
}
string[] empty = [];
foreach (range(len(empty)) as i) {
    print("never runs", empty[i]);
}
print(range(3), range(0), range(-2));

// range(start, end, step = 1): the end is included, as in PHP. Over ints,
// foreach counts without building an array.
foreach (range(1, 3) as n) {
    print(n);
}
foreach (range(10, 0, 5) as index => value) {
    print(index, value);
}
foreach (range('a', 'c') as letter) {
    print(letter);
}
