// std/sql with PostgreSQL: run with QIQ_TEST_POSTGRES=postgres://user:password@host/database
// (it creates and drops a table named users). Types, placeholders, errors, transactions, queryAs.
import Database, Row, Cursor from "std/sql";
import getenv, exit from "std/os";
import microtime from "std/time";

string url = getenv("QIQ_TEST_POSTGRES");
if (url == null) {
    print("skipped: set QIQ_TEST_POSTGRES to a postgres:// URL of a database the test may create tables in");
    exit(0);
}

Database db = Database::open(url);
db->executeScript("drop table if exists users; create table users (id serial primary key, name text not null, email text unique, age integer, score double precision, active boolean, avatar bytea, balance numeric(10, 2));");
byte[] avatar = [1, 2, 255];
int changed = db->execute("insert into users (name, email, age, score, active, avatar, balance) values (?, ?, ?, ?, ?, ?, ?)", "Ada", "ada@example.com", 36, 9.5, true, avatar, "1234.50");
print("inserted", changed, db->lastInsertId());
string missing = null;
db->execute("insert into users (name, email, age, score, active) values (?, ?, ?, ?, ?)", "Lin", missing, 41, 7.25, false);
db->execute("insert into users (name, age) values (?, ?)", "Bob", null);
foreach (db->query("select * from users where age > ? or age is null order by id", 30) as row) {
    print(row->getInt("id"), row->getString("name"), row->getString("email") ?? "-", row->getIntOr("age", -1), row->getDoubleOr("score", 0.0), row->getBoolOr("active", false), row->isNull("avatar"));
}
Row ada = db->queryOne("select avatar, balance, count(*) over () as n, sum(age) over () as total, avg(age) over () as mean from users where name = ?", "Ada");
print(ada->getBytes("avatar"), ada->getString("balance"), ada->getDouble("balance"), ada->getInt("n"), ada->getInt("total"), ada->getDouble("mean"));
print(ada->toMap());
print(db->queryOne("select * from users where name = ?", "Nobody") == null);
print(db->execute("update users set age = age + 1 where age is not null"));
print(db->execute("select 1"));
print(db->queryOne("select 'it''s ? not a placeholder' as a, $$also ? here$$ as b, ? as c -- and ? here", "yes")->toMap());
print(db->queryOne("select '{\"a\": 1}'::jsonb ?? 'a' as has")->getBool("has"));

try { db->execute("insert into users (name, email) values (?, ?)", "Ada2", "ada@example.com"); } catch (DatabaseException e) { print("error:", e->getMessage()); }
try { db->query("select * from users where id = ?"); } catch (DatabaseException e) { print("error:", e->getMessage()); }
try { db->query("select * from nope"); } catch (DatabaseException e) { print("error:", e->getMessage()); }
try { db->execute("delete from users; delete from users"); } catch (DatabaseException e) { print("error:", e->getMessage()); }
try { db->query("select * from users where id = $1", 1); } catch (DatabaseException e) { print("error:", e->getMessage()); }

db->transaction(function(): void {
    db->execute("insert into users (name) values (?)", "Tx1");
});
try {
    db->transaction(function(): void {
        db->execute("insert into users (name) values (?)", "Tx2");
        throw new RuntimeException("boom");
    });
} catch (RuntimeException e) { print("rolled back:", e->getMessage(), db->inTransaction()); }
print(db->queryOne("select count(*) as n from users where name like 'Tx%'")->getInt("n"));
db->begin();
try { db->execute("insert into users (id, name) values (1, 'dup')"); } catch (DatabaseException e) { print("in tx error:", e->getMessage()); }
print("failed tx:", db->inTransaction());
db->rollback();
print("after rollback:", db->inTransaction());

class User { function __construct(public int id, public string name, public int age = 0) {} }
User[] users = db->queryAs("select id, name, age from users order by id limit ?", 2);
print(users[0]->name, users[1]->age);
db->close();

// Cursors and error codes.
Database more = Database::open(url);
more->executeScript("drop table if exists nums; create table nums (n int)");
more->transaction(function(): void {
    foreach (range(600) as i) { more->execute("insert into nums values (?)", i); }
});
Cursor c = more->cursor("select n from nums where n >= ? order by n", 100);
print(c->next()->getInt("n"), len(c->fetch(300)));
try { more->execute("delete from nums"); } catch (DatabaseException e) { print("busy:", e->getMessage()); }
c->close();
print("after close:", more->execute("delete from nums where n < ?", 10));
more->executeScript("drop table if exists uniq; create table uniq (k int primary key)");
more->execute("insert into uniq values (?)", 1);
try { more->execute("insert into uniq values (?)", 1); } catch (UniqueViolationException e) { print("unique:", substr(e->getSqlState(), 0, 2)); }
try { more->query("select * from no_such_table"); } catch (DatabaseException e) { print("state:", e->getSqlState()); }

// Nested transactions: transaction() inside another uses a savepoint.
Database nest = Database::open(url);
nest->executeScript("drop table if exists items; create table items (name varchar(20) primary key)");
function nestedNames(Database nest): string {
    string out = "";
    foreach (nest->query("select name from items order by name") as row) { out += row->getString("name") + " "; }
    return out;
}
// The inner part fails; the outer carries on.
nest->transaction(function(): void {
    nest->execute("insert into items values (?)", "a");
    try {
        nest->transaction(function(): void {
            nest->execute("insert into items values (?)", "b");
            nest->execute("insert into items values (?)", "a");   // duplicate
        });
    } catch (UniqueViolationException e) { print("inner rolled back:", nest->inTransaction()); }
    nest->execute("insert into items values (?)", "c");
});
print(nestedNames(nest), nest->inTransaction());
// The inner part succeeds; the outer fails: everything rolls back.
try {
    nest->transaction(function(): void {
        nest->transaction(function(): void { nest->execute("insert into items values (?)", "d"); });
        nest->transaction(function(): void {
            nest->transaction(function(): void { nest->execute("insert into items values (?)", "e"); });
        });
        throw new RuntimeException("outer fails");
    });
} catch (RuntimeException e) { print(e->getMessage(), nest->inTransaction()); }
print(nestedNames(nest));
// begin() by hand, then transaction() inside it.
nest->begin();
nest->transaction(function(): void { nest->execute("insert into items values (?)", "f"); });
nest->commit();
print(nestedNames(nest));

// The statement cache: more statements than it holds, a table changing under one, DEALLOCATE.
Database cached = Database::open(url);
cached->executeScript("drop table if exists t; create table t (a int, b text); insert into t values (1, 'x')");
// More statements than the cache holds, twice round.
int total = 0;
foreach (range(2) as round) { foreach (range(20) as i) { total += cached->queryOne("select ? + " + to_string(i) + " as n", 1)->getInt("n"); } }
print("cycled:", total, cached->queryOne("select count(*) as n from pg_prepared_statements")->getInt("n"));
print(cached->queryOne("select * from t")->toMap());
// The table changes under a cached select *: prepared again.
cached->execute("alter table t add column c int default 7");
print(cached->queryOne("select * from t")->toMap());
// The server drops every prepared statement.
cached->executeScript("deallocate all");
print("after deallocate:", cached->queryOne("select * from t where a = ?", 1)->getString("b"));
// A byte array where a string was: a separate statement.
cached->execute("create temporary table blobs (v bytea)");
byte[] data = [0, 255];
cached->execute("insert into blobs values (?)", data);
string none = null;
cached->execute("insert into blobs values (?)", none);
print("blobs:", cached->queryOne("select count(*) as n from blobs")->getInt("n"), cached->queryOne("select v from blobs where v is not null")->getBytes("v"));
// In a transaction, a stale statement fails once, then works after rollback.
cached->begin();
cached->execute("alter table t add column d int default 8");
try { cached->queryOne("select * from t"); print("in tx: ok"); } catch (DatabaseException e) { print("in tx:", e->getSqlState(), e->getMessage()); }
cached->rollback();
print(cached->queryOne("select * from t")->toMap());

// Closing a cursor early stops its statement on the server.
Database server = Database::open(url);
server->executeScript("drop table if exists k; create table k (n int)");
server->transaction(function(): void { foreach (range(1000) as i) { server->execute("insert into k values (?)", i); } });
double started = microtime();
Cursor billion = server->cursor("select a.n as x, b.n as y, c.n as z from k a, k b, k c");
billion->next();
billion->close();
print("closed a billion-row query quickly:", microtime() - started < 5.0, server->queryOne("select count(*) as c from k")->getInt("c"));
