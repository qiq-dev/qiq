// File functions, implemented in C (stdlib/runtime/file.c). Paths are
// relative to the directory the program runs in, not to the source file.
//
// Failures throw: FileNotFoundException when the path doesn't exist,
// PermissionDeniedException when access is denied, and IOException for other
// errors (all three extend IOException).

// The whole file as a string. Throws InvalidUtf8Exception when the contents
// aren't valid UTF-8 text.
extern function file_get_contents(string path): string;

// Writes `data` to the file, creating it if needed. Replaces the contents, or
// adds to the end when `append` is true. Returns the number of bytes written.
extern function file_put_contents(string path, string data, bool append = false): int;

// Whether the path exists (file or directory).
extern function file_exists(string path): bool;

// Whether the path is a regular file.
extern function is_file(string path): bool;

// Whether the path is a directory.
extern function is_dir(string path): bool;

// The file's lines, without line endings ("\n" or "\r\n"). A final line
// ending doesn't add an empty line.
extern function file(string path): string[];

// The names in a directory, sorted, without "." and "..". Throws
// IOException when the path isn't a directory.
extern function scandir(string path): string[];

// The file's raw bytes. Unlike file_get_contents, any file can be read,
// including images, archives, and text that isn't UTF-8.
extern function file_get_bytes(string path): byte[];

// Writes the bytes, replacing the file or (with `append`) adding to its end.
// Returns the number of bytes written.
extern function file_put_bytes(string path, byte[] data, bool append = false): int;

// ---------------------------------------------------------------------------
// Paths. These work on the text alone, without looking at the disk (except
// realpath), with "/" between the parts.

// The last part of the path, ignoring trailing slashes: "c" for "/a/b/c/";
// "/" for "/", and "." for "".
extern function basename(string path): string;

// Everything but the last part, cleaned as path_clean does: "/a/b" for
// "/a/b/c/", and "." for "c". path_join(dirname(p), basename(p)) is
// path_clean(p).
extern function dirname(string path): string;

// The last part's extension, from its last ".": ".gz" for "backup.tar.gz",
// and "" for "README", or a name that starts with its only dot, ".bashrc".
extern function path_ext(string path): string;

// The parts joined with "/", then cleaned; empty parts are skipped, and ""
// when all of them are. An absolute part doesn't start the path again:
// path_join("a", "/b") is "a/b".
extern function path_join(string ...parts): string;

// The shortest path to the same place, by the text alone: a single "/"
// between parts, no "." parts, and each ".." removed with the part before
// it. "a//b/./../c/" is "a/c", "/../x" is "/x", and "" is ".".
extern function path_clean(string path): string;

// Whether the path starts at the root, "/".
extern function path_is_absolute(string path): bool;

// A relative path that leads from `base` to `target`: "../c" from "a/b" to
// "a/c", or "." when they're the same. Both are compared as text, so they
// must both be absolute or both relative. Throws InvalidArgumentException
// when there's no such path, as from ".." to "a".
extern function path_rel(string base, string target): string;

// The absolute path, with symbolic links, ".", and ".." resolved. The path
// must exist.
extern function realpath(string path): string;

// ---------------------------------------------------------------------------
// Directories and file operations

// Creates the directory. With `recursive`, it also creates the missing
// directories above it, and it's not an error if the directory exists.
extern function mkdir(string path, bool recursive = false): void;

// Removes the directory, which must be empty. With `recursive`, it removes
// everything in it first; symbolic links inside are removed, not followed.
extern function rmdir(string path, bool recursive = false): void;

// Deletes a file. Directories are removed with rmdir.
extern function unlink(string path): void;

// Moves or renames a file or directory, replacing a file already at `to`.
// Both must be on the same file system.
extern function rename(string from, string to): void;

// Copies a file's contents and permissions to `to`, replacing a file
// already there.
extern function copy(string from, string to): void;

// The file's size in bytes.
extern function filesize(string path): int;

// When the file was last changed, as a timestamp (seconds since 1970) for
// DateTime::fromTimestamp in std/time.
extern function filemtime(string path): int;

// The directory the program runs in, which relative paths start from.
extern function getcwd(): string;

// Makes `path` the directory the program runs in.
extern function chdir(string path): void;

// The directory for temporary files: $TMPDIR, or /tmp.
extern function temp_dir(): string;

// Creates a new, empty file in temp_dir() that only you can read and write,
// named `prefix` and six random characters, and returns its path. Delete it
// with unlink when you're done.
extern function temp_file(string prefix = ""): string;

// The paths that match a wildcard pattern, sorted: "*" matches any run of
// characters within a part, "?" one character, and "[abc]" one of those.
// Names starting with "." match only a pattern part that starts with ".".
// [] when nothing matches.
extern function glob(string pattern): string[];

// ---------------------------------------------------------------------------
// Open files. Functions whose names start with "__" are visible only inside
// the standard library; programs use the File class below.

extern function __file_open(string path, string mode): int;
extern function __file_read_line(int handle): string;
extern function __file_read(int handle, int length): byte[];
extern function __file_write(int handle, string text): void;
extern function __file_write_bytes(int handle, byte[] data): void;
extern function __file_eof(int handle): bool;
extern function __file_flush(int handle): void;
extern function __file_close(int handle): void;

// A file opened for reading or writing a piece at a time, so large files
// don't have to fit in memory. Writes are buffered; close() (or the program
// ending) flushes them. Errors throw the same exceptions as the functions
// above, and using a file after close() throws IOException.
final class File {
    private int handle;

    private function __construct(int handle) {
        this->handle = handle;
    }

    // Opens `path`. Modes: "r" read, "w" write (emptying the file first),
    // "a" append, "x" create a new file (throws IOException if it exists);
    // add "+" to also allow the other direction, e.g. "r+".
    static function open(string path, string mode = "r"): File {
        return new File(__file_open(path, mode));
    }

    static function stdin(): File {
        return new File(0);
    }

    static function stdout(): File {
        return new File(1);
    }

    static function stderr(): File {
        return new File(2);
    }

    // The next line without its line ending ("\n" or "\r\n"), or null at the
    // end of the file. Throws InvalidUtf8Exception if the line isn't UTF-8.
    function readLine(): string {
        return __file_read_line(this->handle);
    }

    // Up to `length` bytes; fewer only at the end of the file, and an empty
    // array after it.
    function read(int length): byte[] {
        return __file_read(this->handle, length);
    }

    function write(string text): void {
        __file_write(this->handle, text);
    }

    function writeBytes(byte[] data): void {
        __file_write_bytes(this->handle, data);
    }

    // Whether there is nothing left to read.
    function eof(): bool {
        return __file_eof(this->handle);
    }

    // Writes buffered data to the file now.
    function flush(): void {
        __file_flush(this->handle);
    }

    // Flushes and closes the file. Closing twice does nothing. Closing
    // stdin, stdout, or stderr only flushes them.
    function close(): void {
        __file_close(this->handle);
    }
}
