// Array and map functions that take a callback. They're ordinary generic
// functions: T and U (and K and V for maps) come from the arguments, or from
// the type the result is used as, so an anonymous function's parameters can
// leave out their types:
//
//   string[] labels = array_map([1, 2, 3], fn(n) => f"#{n}");
//
// The callback runs inside a foreach over the array or map, so one that
// changes it behaves as it would in a loop written by hand. Every function
// here is available in every file without an import, and cannot be
// redeclared. (array_find and usort are built into the compiler.)

// A new array of what `callback` returns for each element, in order.
function array_map<T, U>(T[] array, function(T): U callback): U[] {
    U[] result = [];
    foreach (array as element) {
        array_push(result, callback(element));
    }
    return result;
}

// A new array of the elements for which `callback` returns true, in order.
function array_filter<T>(T[] array, function(T): bool callback): T[] {
    T[] result = [];
    foreach (array as element) {
        if (callback(element)) {
            array_push(result, element);
        }
    }
    return result;
}

// `callback` called with `initial` and the first element, then with its
// result and the second element, and so on: the last result, or `initial`
// for an empty array.
function array_reduce<T, U>(T[] array, function(U, T): U callback, U initial): U {
    U result = initial;
    foreach (array as element) {
        result = callback(result, element);
    }
    return result;
}

// The index of the first element for which `callback` returns true, or -1.
function array_find_index<T>(T[] array, function(T): bool callback): int {
    foreach (array as index => element) {
        if (callback(element)) {
            return index;
        }
    }
    return -1;
}

// Whether `callback` returns true for at least one element, stopping at the
// first; false for an empty array.
function array_any<T>(T[] array, function(T): bool callback): bool {
    foreach (array as element) {
        if (callback(element)) {
            return true;
        }
    }
    return false;
}

// Whether `callback` returns true for every element, stopping at the first
// that fails; true for an empty array.
function array_all<T>(T[] array, function(T): bool callback): bool {
    foreach (array as element) {
        if (!callback(element)) {
            return false;
        }
    }
    return true;
}

// A new map of the entries for which `callback`, given each key and value,
// returns true, in the map's order.
function map_filter<K: key, V>(map[K, V] entries, function(K, V): bool callback): map[K, V] {
    map[K, V] result = {};
    foreach (entries as key => value) {
        if (callback(key, value)) {
            result[key] = value;
        }
    }
    return result;
}

// A new map with the same keys, in the same order, and what `callback`
// returns for each value.
function map_map<K: key, V, W>(map[K, V] entries, function(V): W callback): map[K, W] {
    map[K, W] result = {};
    foreach (entries as key => value) {
        result[key] = callback(value);
    }
    return result;
}
