// argv(), exit(), and getenv(). Try:
//   ./target/release/qiq run tests/program.qiq Ada "Grace Hopper"; echo $?
import File from "std/file";
import argv, exit, getenv from "std/os";

string[] args = argv();
print("program:", args[0], "arguments:", len(args) - 1);
if (len(args) < 2) {
    print("usage: " + args[0] + " <name> [more...]");
    exit(2);
}
foreach (range(1, len(args) - 1) as i) {
    print(i, args[i]);
}
string home = getenv("HOME") ?? "/tmp";
print("home set:", home != "", "verbose:", getenv("VERBOSE") != null, getenv("QIQ_UNSET_VAR") ?? "unset");
File out = File::stdout();
out->write("buffered line\n");
try {
    exit(3);
} finally {
    print("finally does not run on exit");
}
