# Cargo build output
/target/

# Compiled object files
*.o
*.obj

# Everything the test programs build or write: only the programs, their
# expected output, and the runner are kept (see tests/programs.rs).
/tests/**
!/tests/**/
!/tests/**/*.qiq
!/tests/**/*.out
!/tests/**/*.err
!/tests/*.rs

# Python bytecode
__pycache__/

# Generated manual (python3 docs/generate.py)
/docs/html/
