// Exception classes. Every class here is available in every file without an
// import. Throw with `throw new SomeException("message");` and handle with
// try/catch; your own exceptions extend Exception or one of its subclasses.
//
// Exception
// ├── RuntimeException
// │   ├── IOException
// │   │   ├── FileNotFoundException
// │   │   ├── PermissionDeniedException
// │   │   └── NetworkException
// │   ├── DatabaseException
// │   │   └── ConstraintViolationException
// │   │       └── UniqueViolationException
// │   ├── ProcessException
// │   ├── KeyNotFoundException
// │   ├── OutOfRangeException
// │   └── InvalidUtf8Exception
// ├── ArithmeticException
// │   └── DivisionByZeroException
// ├── InvalidArgumentException
// ├── JsonException
// └── HttpException
//
// The runtime raises some of these itself (see QiqExceptionKind in
// stdlib/runtime/qiq_runtime.h).

class Exception {
    protected string message;
    protected int code;

    function __construct(string message = "", int code = 0) {
        this->message = message;
        this->code = code;
    }

    function getMessage(): string {
        return this->message;
    }

    function getCode(): int {
        return this->code;
    }
}

// Errors that can only be detected while the program runs.
class RuntimeException extends Exception {}

// Reading or writing files failed.
class IOException extends RuntimeException {}
class FileNotFoundException extends IOException {}
class PermissionDeniedException extends IOException {}

// A network connection failed: the host couldn't be found, refused the
// connection, timed out, or failed the TLS certificate check.
class NetworkException extends IOException {}

// A database couldn't be opened, or rejected a statement: an SQL syntax
// error, a broken constraint, a missing table, or the wrong number of
// values for the placeholders (std/sql). getSqlState() is the standard
// five-character SQLSTATE ("42P01"; "HY000" for a general error) and
// getCode() the database's own error number (SQLite's extended result
// code, MySQL's error number; 0 for PostgreSQL, which has none).
class DatabaseException extends RuntimeException {
    protected string sqlState;

    function __construct(string message = "", int code = 0) {
        parent::__construct(message, code);
        // Raised by the runtime: the database's code and SQLSTATE; otherwise
        // the state is HY000, a general error.
        if (__database_error_pending()) {
            this->code = __database_error_code();
        }
        this->sqlState = __database_error_state();
    }

    function getSqlState(): string {
        return this->sqlState;
    }
}

// A statement broke a constraint (SQLSTATE class 23): NOT NULL, CHECK, a
// foreign key, or a unique key.
class ConstraintViolationException extends DatabaseException {}

// A row would duplicate another's value in a unique key or primary key.
class UniqueViolationException extends ConstraintViolationException {}

// The details of the database error the runtime is raising (core.c).
extern function __database_error_pending(): bool;
extern function __database_error_code(): int;
extern function __database_error_state(): string;

// A map lookup used a key that is not in the map.
// A command couldn't be run (std/os exec and shell): it wasn't found,
// isn't executable, the working directory doesn't exist, or it ran past
// its timeout. A command that runs and exits with an error status doesn't
// throw; check ProcessResult's exitCode.
class ProcessException extends RuntimeException {}

class KeyNotFoundException extends RuntimeException {}

// An array index is below 0 or not less than the array's length.
class OutOfRangeException extends RuntimeException {}

// A string is not valid UTF-8.
class InvalidUtf8Exception extends RuntimeException {}

// An arithmetic operation has no result, such as a negative int exponent.
class ArithmeticException extends Exception {}

// `/` or `%` on ints with a zero right-hand side.
class DivisionByZeroException extends ArithmeticException {}

// A function was given an argument it cannot accept.
class InvalidArgumentException extends Exception {}

// json_decode was given text that isn't JSON or doesn't match the type it
// decodes into, or json_encode was given a value JSON can't represent.
class JsonException extends Exception {}

// An HTTP request got an error status (from Response::raiseForStatus, with
// the status as its code) or was redirected too many times.
class HttpException extends Exception {}
