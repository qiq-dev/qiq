// std/net's Url: parsing, escaping, the query, the with methods, resolving (RFC 3986's examples),
// errors, JSON, and Request::url.
import Url from "std/net";
import Request, ResponseWriter, Router, http_serve from "std/net/http/server";
Url api = Url::parse("https://api.example.com/v1/");
Url search = api->resolve("search")->withQuery("q", "café & crème")->withQuery("page", "2");
print(search);
Url link = Url::parse("https://us%20er:p@ss@[2001:db8::1]:8443/a%20b/c?tag=x&tag=y&empty&plus=a+b#top%20part");
print(link->scheme(), link->user(), link->password(), link->host(), link->port(), link->path(), link->rawPath(), link->fragment());
print(link->query("tag"), link->queryAll("tag"), link->query("empty") == "", link->query("missing") == null, link->query("plus"), link->queryNames());
print(link);
Url base = Url::parse("http://a/b/c/d;p?q");
foreach (["g:h", "g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", "g?y#s", ";x", "g;x", "", ".", "./", "..", "../", "../g", "../..", "../../", "../../g", "../../../g", "/./g", "/../g", "g.", ".g", "g..", "..g", "./../g", "./g/.", "g/./h", "g/../h", "g;x=1/./y", "g;x=1/../y"] as ref) {
    print(ref, "->", base->resolve(ref));
}
print(Url::parse("mailto:ada@example.com")->path(), Url::parse("mailto:ada@example.com")->host() == null, Url::parse("file:///tmp/a%20b"), Url::parse("file:///tmp/a%20b")->host() == "");
print(Url::parse("http://x.com/a b/é?q=1 2#f g"), Url::parse("HTTP://Example.com:80"), Url::parse("http://x.com:")->port());
print(search->withoutQuery("q"), search->withoutQuery("q")->withoutQuery("page"), search->withAddedQuery("page", "3"), search->withRawQuery("a=1&b=2"), search->withRawQuery(null));
print(api->withScheme("http")->withHost("::1")->withPort(8080)->withPath("/a b/ü")->withFragment("x y")->withUser("ada", "s:e@c"));
print(Url::parse("relative/path?x=1")->isAbsolute(), api->isAbsolute(), api->equals(Url::parse("https://api.example.com/v1/")), api == Url::parse("https://api.example.com/v1/"));
foreach (["http://x.com/%zz", "http://x.com:99999/", "http://x.com:8a/", "http://[::1/", "http://ex ample.com/", "http://x.com/%C3"] as bad) {
    try { Url::parse(bad); print("parsed", bad); } catch (InvalidArgumentException e) { print("error:", e->getMessage()); }
}
try { api->withPort(70000); } catch (InvalidArgumentException e) { print("error:", e->getMessage()); }
try { api->withHost("a/b"); } catch (InvalidArgumentException e) { print("error:", e->getMessage()); }
try { api->withScheme("1http"); } catch (InvalidArgumentException e) { print("error:", e->getMessage()); }

class Link { public string title; public Url href; }
Link l = new Link();
l->title = "docs";
l->href = Url::parse("https://example.com/a b?x=1");
print(json_encode(l), json_encode([Url::parse("/x"), null]));
Request r = new Request("GET", "/items/a%20b", "page=2&tag=x", "HTTP/1.1", {"host" => "shop.example.com:8080"}, [], "127.0.0.1:5000");
Url u = r->url();
print(u, u->host(), u->port(), u->path(), u->query("page"));
