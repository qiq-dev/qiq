// Counting
int i = 0;
while (i < 3) {
    print(i);
    i = i + 1;
}

// break and continue
int n = 0;
while (true) {
    n = n + 1;
    if (n % 2 == 0) {
        continue;
    }
    if (n > 7) {
        break;
    }
    print(n);
}

// ! negates a bool
bool done = false;
int steps = 0;
while (!done) {
    steps = steps + 1;
    done = steps >= 4;
}
print(steps);
print(!true);
print(!(1 > 2) && !false);

// A function can end with `while (true)` that only leaves by returning.
function firstPowerOfTwoAbove(int limit): int {
    int value = 1;
    while (true) {
        if (value > limit) {
            return value;
        }
        value = value * 2;
    }
}
print(firstPowerOfTwoAbove(100));

// finally runs on continue and break inside while.
int round = 0;
while (round < 5) {
    round = round + 1;
    try {
        if (round == 2) {
            continue;
        }
        if (round == 3) {
            break;
        }
        print("round " + substr("123", round - 1, 1));
    } finally {
        print("finally");
    }
}

// A foreach nested in a while runs many times without growing the stack.
int total = 0;
int pass = 0;
int[] digits = [1, 2, 3];
while (pass < 200000) {
    foreach (digits as digit) {
        total = total + digit;
    }
    pass = pass + 1;
}
print(total);

// Splitting text into lines with while, strpos, and substr.
string text = "alpha\nbeta\ngamma";
while (len(text) > 0) {
    int end = strpos(text, "\n");
    if (end == -1) {
        print(text);
        text = "";
    } else {
        print(substr(text, 0, end));
        text = substr(text, end + 1);
    }
}

// do-while, and break and continue with a number of levels.
// do-while runs once even when the condition is false.
int start = 10;
do {
    print("once", start);
    start++;
} while (start < 5);

int tries = 0;
do {
    tries++;
    if (tries == 2) {
        continue;
    }
    print("try", tries);
} while (tries < 4);

// break 2 leaves both loops.
foreach ([1, 2, 3] as i) {
    foreach ([10, 20, 30] as j) {
        if (j == 20 && i == 2) {
            break 2;
        }
        print(i, j);
    }
}
print("after");

// continue 2 goes on with the outer loop.
foreach ([1, 2] as i) {
    int k = 0;
    while (k < 3) {
        k++;
        if (k == 2) {
            continue 2;
        }
        print("i", i, "k", k);
    }
    print("never");
}

// A switch counts for break, not for continue.
foreach ([1, 2, 3] as i) {
    switch (i) {
        case 2:
            continue;
        case 3:
            break 2;
        default:
            print("case", i);
    }
    print("end of", i);
}
print("done");

function firstPair(int[][] rows, int target): string {
    string found = "none";
    foreach (rows as r => row) {
        foreach (row as c => value) {
            if (value == target) {
                found = f"{r},{c}";
                break 2;
            }
        }
    }
    return found;
}
print(firstPair([[1, 2], [3, 4]], 3));

function spin(): int {
    int x = 0;
    do {
        x++;
        if (x > 3) {
            return x;
        }
    } while (true);
}
print(spin());

// `do` is a keyword only before {, so it can still be a name.
int do = 3;
print(do);
