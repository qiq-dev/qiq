// Generic classes and functions: type parameters, filled in where used.
interface Show {
    function show(): string;
}

class Box<T> {
    public T value;

    function __construct(T value) {
        this->value = value;
    }
}

// A class's type parameters are used in its properties and methods, and it
// can mention itself (Node<T> next) and other generic classes.
class Node<T> {
    public T value;
    public Node<T> next = null;

    function __construct(T value) {
        this->value = value;
    }
}

class LinkedList<T> implements Show {
    private Node<T> head = null;
    private int count = 0;

    function prepend(T value): LinkedList<T> {
        Node<T> node = new Node(value);
        node->next = this->head;
        this->head = node;
        this->count++;
        return this;
    }

    function toArray(): T[] {
        T[] values = [];
        Node<T> current = this->head;
        while (current != null) {
            array_push(values, current->value);
            current = current->next;
        }
        return values;
    }

    function show(): string {
        return f"a list of {this->count}";
    }
}

class Pair<A, B> {
    public A first;
    public B second;

    function __construct(A first, B second) {
        this->first = first;
        this->second = second;
    }

    function swap(): Pair<B, A> {
        return new Pair(this->second, this->first);
    }
}

// Type arguments can be written, or inferred: from the constructor's
// arguments, or from the type the object is used as.
Box<int> written = new Box<int>(5);
Box<string> inferred = new Box("hi");
LinkedList<int> numbers = new LinkedList();
numbers->prepend(3)->prepend(2)->prepend(1);
print(written->value + 1, inferred->value, numbers->toArray(), numbers->show());
print(written, numbers);

Pair<int, string> pair = new Pair(1, "one");
Pair<string, int> swapped = pair->swap();
print(swapped->first, swapped->second, swapped);

Box<Box<int>> nested = new Box(new Box(7));
print(nested->value->value, nested);

// Generic functions: the type arguments come from the arguments.
function firstOr<T>(T[] values, T fallback): T {
    return len(values) > 0 ? values[0] : fallback;
}

function transform<T, U>(T[] values, function(T): U change): U[] {
    U[] result = [];
    foreach (values as value) {
        array_push(result, change(value));
    }
    return result;
}

function listOf<T>(T ...values): T[] {
    return values;
}

function emptyList<T>(): T[] {
    return [];
}

print(firstOr([3, 4], 0), firstOr([], "none"), listOf(1, 2, 3));
print(transform([1, 2, 3], fn(n) => n * 10), transform(["a", "bb"], fn(string s) => len(s)));
// When the arguments don't decide, the type the result is used as does.
int[] none = emptyList();
print(len(none));

// Bounds: T must be the class or interface after the colon, and code
// using a T can call that type's methods.
interface HasLength {
    function length(): int;
}

class Word implements HasLength {
    public string text;

    function __construct(string text) {
        this->text = text;
    }

    function length(): int {
        return len(this->text);
    }
}

function longest<T: HasLength>(T[] items): T {
    T best = items[0];
    foreach (items as item) {
        if (item->length() > best->length()) {
            best = item;
        }
    }
    return best;
}

class Shelf<T: HasLength> {
    private T[] items = [];

    function add(T item): void {
        array_push(this->items, item);
    }

    function totalLength(): int {
        int total = 0;
        foreach (this->items as item) {
            total += item->length();
        }
        return total;
    }
}

print(longest([new Word("hi"), new Word("hello"), new Word("hey")])->text);
Shelf<Word> shelf = new Shelf();
shelf->add(new Word("abc"));
shelf->add(new Word("de"));
print(shelf->totalLength());

// Objects of generic classes work everywhere objects do.
Show shown = numbers;
Box<int>[] boxes = [new Box(1), new Box(2)];
map[string, Box<string>] named = {"a" => new Box("A")};
print(shown->show(), boxes[1]->value, named["a"]->value);
print(json_encode(nested), json_encode(boxes));
Box<int> decoded = json_decode("{\"value\": 42}");
print(decoded->value);

// Generic interfaces, implemented by generic classes and by ordinary ones.
interface Comparable<T> {
    function compareTo(T other): int;
}

interface Repository<T> {
    function find(int id): T;
    function save(T item): void;
    function count(): int;
}

class Money implements Comparable<Money> {
    public int cents;

    function __construct(int cents) {
        this->cents = cents;
    }

    function compareTo(Money other): int {
        return this->cents - other->cents;
    }
}

class MemoryRepository<T> implements Repository<T> {
    private map[int, T] items = {};

    function find(int id): T {
        return this->items[id];
    }

    function save(T item): void {
        this->items[len(this->items) + 1] = item;
    }

    function count(): int {
        return len(this->items);
    }
}

// A bound can mention its own parameter: T must be comparable with T.
function largest<T: Comparable<T>>(T[] items): T {
    T best = items[0];
    foreach (items as item) {
        if (item->compareTo(best) > 0) {
            best = item;
        }
    }
    return best;
}

// The type arguments of `new` can come from an interface the object is used as.
Repository<Word> words = new MemoryRepository();
words->save(new Word("first"));
words->save(new Word("second"));
print(words->find(2)->text, words->count(), words);
print(largest([new Money(5), new Money(12), new Money(7)])->cents);

// Generic methods: type parameters of their own, inferred at each call.
class Converter<T> {
    public T value;

    function __construct(T value) {
        this->value = value;
    }

    function convert<U>(function(T): U change): Converter<U> {
        return new Converter(change(this->value));
    }
}

// Ordinary classes can have generic methods too, static ones included.
class Lists {
    static function repeat<V>(V value, int times): V[] {
        V[] values = [];
        foreach (range(times) as i) {
            array_push(values, value);
        }
        return values;
    }
}

Converter<int> number = new Converter(21);
Converter<string> label = number->convert(fn(n) => f"#{n * 2}");
print(label->value, label, number->convert(fn(int n) => n > 20)->value);
print(Lists::repeat("ab", 3), Lists::repeat(Money::class, 1));

// T: object: any object type, so a T can be null.
class Slot<T: object> {
    public T value = null;

    function isEmpty(): bool {
        return this->value == null;
    }
}
Slot<Word> slot = new Slot();
print(slot->isEmpty());
slot->value = new Word("x");
print(slot->isEmpty());

// Generic classes can be abstract, extend classes (generic or not), be
// extended, and have static members.
abstract class Collection<T> {
    protected T[] items = [];
    public static int made = 0;

    function __construct() {
        self::made++;
    }

    function add(T item): Collection<T> {
        array_push(this->items, item);
        return this;
    }

    function size(): int {
        return len(this->items);
    }

    abstract function label(): string;
}

class Stack<T> extends Collection<T> {
    function pop(): T {
        return array_pop(this->items);
    }

    function label(): string {
        return "stack";
    }
}

class CountingStack<T> extends Stack<T> {
    public int pushes = 0;

    function add(T item): Collection<T> {
        this->pushes++;
        return parent::add(item);
    }

    function label(): string {
        return "counting " + parent::label();
    }
}

// An ordinary class can extend a generic class made for its types.
class History extends Stack<string> {
    function label(): string {
        return "history";
    }
}

function describe(Collection<string> collection): string {
    return f"{collection->label()} of {collection->size()}";
}

CountingStack<string> counting = new CountingStack();
counting->add("a")->add("b");
History history = new History();
history->add("x");
print(counting->pop(), counting->pushes, describe(counting), describe(history));
print(Collection<string>::made);

// Type arguments given with the call, where inference has nothing to go on.
function emptyOf<T>(): T[] {
    return [];
}

function firstOrElse<T>(T[] items, T fallback): T {
    return len(items) > 0 ? items[0] : fallback;
}

class Repeat {
    static function times<T>(T value, int count): T[] {
        T[] result = [];
        while (len(result) < count) {
            array_push(result, value);
        }
        return result;
    }
}

print(len(emptyOf<string>()), firstOrElse<int>([], -1), firstOrElse<string>([], "none"));
print(Repeat::times<char>('x', 3));
