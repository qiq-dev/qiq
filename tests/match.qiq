// match: an expression that picks a value by comparing one value with each arm.
enum Status: string {
    case Active = "active";
    case Archived = "archived";
    case Draft = "draft";
}
function label(Status s): string {
    return match (s) {
        Status::Active => "on",
        Status::Archived, Status::Draft => "off",
    };
}
print(label(Status::Active), label(Status::Draft));
int code = 404;
string text = match (code) {
    200, 204 => "ok",
    404 => "not found",
    default => "error " + to_string(code),
};
print(text, match (500) { 200 => "ok", default => "other" });
double factor = match ("b") { "a" => 1.5, "b" => 2.5 };
print(factor);
?int maybe = match (true) { true => 5, false => null };
print(maybe);
string[] parts = match (1) { 1 => ["x"], default => [] };
print(parts);
function match(int x): int { return x + 1; }
print(match(1));
try {
    print(match (7) { 1 => "one" });
} catch (UnhandledMatchException e) {
    print(e::class, e->getMessage());
}
try {
    print(match ("q") { "a" => 1 });
} catch (UnhandledMatchException e) {
    print(e->getMessage());
}
function next(): int { print("evaluated once"); return 2; }
print(match (next()) { 1 => "first", 2 => "second", 3 => "third" });

// Nullable subjects and null arms. A ?int variable matched on is its int in
// the arms null can't reach.
function describeCode(?int code): string {
    return match (code) {
        null => "no code",
        200, 204 => f"ok {code + 0}",
        default => f"code {code * 1}",
    };
}
print(describeCode(null), describeCode(200), describeCode(404));

function labelOrUnknown(Status s): string {
    return match (s) {
        null => "unknown",
        Status::Active => "on",
        Status::Archived, Status::Draft => "off",
    };
}
Status unset = null;
print(labelOrUnknown(Status::Active), labelOrUnknown(unset));

function wordScore(string w): int {
    return match (w) { null => -1, "a" => 1, default => 0 };
}
string missing = null;
print(wordScore("a"), wordScore(missing), wordScore("z"));

// Without a null arm, null goes to the default, or throws.
?double d = null;
print(match (d) { 1.5 => "one and a half", default => "other" });
?bool flag = true;
print(match (flag) { true => "yes", false => "no", null => "unset" });
?int nothing = null;
try {
    print(match (nothing) { 1 => "one" });
} catch (UnhandledMatchException e) {
    print(e->getMessage());
}
