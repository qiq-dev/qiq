// Bitwise operators work on ints.
int flags = 12;          // 0b1100
print(flags & 10);       // 8   (0b1000)
print(flags | 3);        // 15  (0b1111)
print(flags ^ 10);       // 6   (0b0110)
print(~flags);           // -13
print(1 << 4);           // 16
print(-16 >> 2);         // -4: >> keeps the sign
print(1 << 63);          // -9223372036854775808
print(1 << 64);          // 0: shifting by the full width (64) or more
print(-1 >> 40);         // -1

// Bitwise operators bind tighter than comparisons, so this tests (n & 1) == 0.
int n = 6;
if (n & 1 == 0) {
    print("even");
}

// Precedence: shifts below + -, then &, ^, | from tightest to loosest.
print(1 << 2 + 1);       // 8: 1 << 3
print(6 & 3 | 8);        // 10: (6 & 3) | 8
print(1 | 6 ^ 3);        // 5: 1 | (6 ^ 3)
print(~0 & 255);         // 255

// Flag sets
int read = 1;
int write = 2;
int execute = 4;
int permissions = read | execute;
if (permissions & write != 0) {
    print("can write");
} else {
    print("cannot write");
}
permissions = permissions | write;
if (permissions & write != 0) {
    print("can write now");
}
