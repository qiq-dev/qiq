// Hashing and encoding: message digests, HMACs, hex, base64, and password hashing, implemented in C
// (stdlib/runtime/crypto.c) with Mbed TLS.
//
//   import sha1, hash, hash_hmac from "std/crypto";
//
// Algorithms are named as in PHP, in any case: "md5", "sha1", "sha224",
// "sha256", "sha384", "sha512". An unknown one throws
// InvalidArgumentException. Digests come back as lowercase hex, except from
// hash_bytes. MD5 and SHA-1 are fine for checksums and cache keys, but not
// for passwords or signatures that must resist attack.

// The MD5 digest of `text`'s UTF-8 bytes, in hex: md5("abc") is
// "900150983cd24fb0d6963f7d28e17f72".
extern function md5(string text): string;

// The SHA-1 digest of `text`, in hex.
extern function sha1(string text): string;

// The digest of `text` with `algorithm`, in hex: hash("sha256", text).
extern function hash(string algorithm, string text): string;

// The HMAC of `text` with `key` (PHP's argument order), in hex: for signing
// messages, such as webhooks and API requests.
extern function hash_hmac(string algorithm, string text, string key): string;

// The digest of `data` with `algorithm`, as raw bytes: for binary data, such
// as hash_bytes("sha256", file_get_bytes(path)).
extern function hash_bytes(string algorithm, byte[] data): byte[];

// Bytes as lowercase hex, two digits per byte: bin2hex([1, 171]) is "01ab".
extern function bin2hex(byte[] data): string;

// Base64 (RFC 4648), as PHP's base64_encode writes it: the standard
// alphabet with '=' padding. Decoding also accepts the URL-safe alphabet
// ('-' and '_', as in JWTs), skips whitespace, and doesn't require the
// padding; anything else throws InvalidArgumentException.

// `text`'s UTF-8 bytes in base64: base64_encode("hi") is "aGk=".
extern function base64_encode(string text): string;

// Bytes in base64, for binary data.
extern function base64_encode_bytes(byte[] data): string;

// The text that `text` encodes. Throws InvalidUtf8Exception when it decodes
// to bytes that aren't UTF-8 text; use base64_decode_bytes for those.
extern function base64_decode(string text): string;

// The bytes that `text` encodes.
extern function base64_decode_bytes(string text): byte[];

// Passwords, hashed with bcrypt as PHP's password_hash does (qiq names the
// algorithm, and has no other yet): a "$2y$" hash with a random salt, which
// bcrypt_verify checks, as PHP's password_verify does. `cost` is the log2 of
// the work (4 to 31): each step doubles the time, and 12 takes about a
// quarter of a second. bcrypt only uses a password's first 72 bytes, so a
// longer one throws InvalidArgumentException rather than being cut short.
extern function bcrypt_hash(string password, int cost = 12): string;

// Whether `password` matches `hash`, a hash from bcrypt_hash (or from
// PHP's, or any "$2y$", "$2b$", or "$2a$" bcrypt hash). False for a hash
// that isn't one.
extern function bcrypt_verify(string password, string hash): bool;
